<UserControl x:Class="SpotImageViewer.WPF.Views.ViewerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Background="{StaticResource BrushBgDark}">
        
        <!-- ============================================================ -->
        <!-- STATE 1: WELCOME SCREEN (Shown when no consumer is loaded)  -->
        <!-- ============================================================ -->
        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="32,16">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasConsumer}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Hero Title & Subtitle -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                <Border Width="64" Height="64" CornerRadius="16" Background="#1e293b" BorderBrush="#334155" BorderThickness="1" Margin="0,0,0,12" HorizontalAlignment="Center">
                    <TextBlock Text="📷" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="Welcome to Spot Image Viewer" FontSize="26" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" />
                <TextBlock Text="Ultra-fast spot bill photo verification, consumer intelligence, and live SAP portal audit studio." 
                           FontSize="13" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" Margin="0,6,0,0" />
            </StackPanel>

            <!-- 4-Column Feature Cards Grid -->
            <UniformGrid Grid.Row="1" Columns="4" MaxWidth="1000" Margin="0,0,0,24" HorizontalAlignment="Stretch">
                <!-- Card 1 -->
                <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="6">
                    <StackPanel>
                        <TextBlock Text="🔍" FontSize="20" Margin="0,0,0,8" />
                        <TextBlock Text="Instant Search" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
                        <TextBlock Text="Lookup by 9-digit Consumer ID, Meter No, or Name with auto-detection." 
                                   FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Card 2 -->
                <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="6">
                    <StackPanel>
                        <TextBlock Text="🗓️" FontSize="20" Margin="0,0,0,8" />
                        <TextBlock Text="Cycle Timeline" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
                        <TextBlock Text="Inspect multi-month spot bill photos side-by-side in high-res DirectX canvas." 
                                   FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Card 3 -->
                <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="6">
                    <StackPanel>
                        <TextBlock Text="⚡" FontSize="20" Margin="0,0,0,8" />
                        <TextBlock Text="Live OSD Portal" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
                        <TextBlock Text="Real-time SAP WebDynpro outstanding dues, LPSC, and connection status." 
                                   FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Card 4 -->
                <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="6">
                    <StackPanel>
                        <TextBlock Text="🛡️" FontSize="20" Margin="0,0,0,8" />
                        <TextBlock Text="Audit Studio" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,4" />
                        <TextBlock Text="Low consumption audit, tamper checks, and one-click DCRC Excel export." 
                                   FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Bottom Shortcuts Helper Bar -->
            <Border Grid.Row="2" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="14,8" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Quick Shortcuts:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Border Background="{StaticResource BrushBgDark}" CornerRadius="4" Padding="6,2" Margin="0,0,4,0"><TextBlock Text="/" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAccentSky}" /></Border>
                    <TextBlock Text="Search" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Border Background="{StaticResource BrushBgDark}" CornerRadius="4" Padding="6,2" Margin="0,0,4,0"><TextBlock Text="Enter" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAccentSky}" /></Border>
                    <TextBlock Text="Lookup" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Border Background="{StaticResource BrushBgDark}" CornerRadius="4" Padding="6,2" Margin="0,0,4,0"><TextBlock Text="← / →" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAccentSky}" /></Border>
                    <TextBlock Text="Cycle Photos" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Border Background="{StaticResource BrushBgDark}" CornerRadius="4" Padding="6,2" Margin="0,0,4,0"><TextBlock Text="R" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAccentSky}" /></Border>
                    <TextBlock Text="Rotate 90°" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <Border Background="{StaticResource BrushBgDark}" CornerRadius="4" Padding="6,2" Margin="0,0,4,0"><TextBlock Text="Esc" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAccentSky}" /></Border>
                    <TextBlock Text="Reset" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>


        <!-- ============================================================ -->
        <!-- STATE 2: ACTIVE CONSUMER IMAGE VIEWER (DirectX Accelerated)  -->
        <!-- ============================================================ -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasConsumer}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Top Consumer Bar -->
                <RowDefinition Height="*" />    <!-- Center Image Canvas -->
                <RowDefinition Height="Auto" /> <!-- Bottom Filmstrip -->
            </Grid.RowDefinitions>

            <!-- 1. Top Consumer Header & Live OSD Info Bar -->
            <Border Grid.Row="0" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="0,0,0,1" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Consumer Information -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource BrushBgDarkest}" CornerRadius="6" Padding="8,4" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="CID: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding Consumer.ConsumerId}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource BrushAccentSky}" />
                            </StackPanel>
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="{Binding Consumer.Name}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="{Binding Consumer.Address}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="400" />
                        </StackPanel>
                        <Border Background="{StaticResource BrushBgDark}" CornerRadius="6" Padding="6,3" Margin="0,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Consumer.Class}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                        </Border>
                        <Border Background="{StaticResource BrushBgDark}" CornerRadius="6" Padding="6,3" Margin="0,0,8,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Meter: " FontSize="10" Foreground="{StaticResource BrushTextSecondary}" />
                                <TextBlock Text="{Binding Consumer.MeterNo}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Live OSD Summary & Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- OSD Status Badge -->
                        <Border CornerRadius="6" Padding="10,4" Margin="0,0,8,0" Background="#131f37" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="SAP OSD: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,4,0" />
                                <TextBlock Text="{Binding LiveOsd.ConnectionStatus, FallbackValue='Checking...'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccentEmerald}" />
                                <TextBlock Text=" | Dues: ₹" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="6,0,0,0" />
                                <TextBlock Text="{Binding LiveOsd.TotalDues, FallbackValue='0.00'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccentRose}" />
                            </StackPanel>
                        </Border>

                        <Button Style="{StaticResource BtnSecondary}" Content="📄 Open PDF" Command="{Binding OpenPdfCommand}" Margin="0,0,6,0" />
                        <Button Style="{StaticResource BtnSecondary}" Content="🔄 Refresh OSD" Command="{Binding FetchLiveOsdCommand}" Margin="0,0,6,0" />
                        <Button Style="{StaticResource BtnSecondary}" Content="📋 Copy CID" Command="{Binding CopyConsumerIdCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 2. Center DirectX Hardware Canvas -->
            <Grid Grid.Row="1" x:Name="CanvasContainer" ClipToBounds="True" Background="#050811">
                <!-- Transformable Container -->
                <Grid x:Name="ImageTransformHost" RenderTransformOrigin="0.5,0.5">
                    <Grid.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform x:Name="ImgScale" ScaleX="1.0" ScaleY="1.0" />
                            <TranslateTransform x:Name="ImgTranslate" X="0" Y="0" />
                            <RotateTransform x:Name="ImgRotate" Angle="{Binding RotationAngle}" />
                        </TransformGroup>
                    </Grid.RenderTransform>

                    <Image x:Name="MainImageControl" 
                           Source="{Binding CurrentBitmap}" 
                           RenderOptions.BitmapScalingMode="HighQuality"
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center"
                           Stretch="Uniform" />
                </Grid>

                <!-- Floating Canvas Toolbar (Top Right) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Background="#cc1e293b" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="6">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource BtnSecondary}" Content="⟲ -90°" Command="{Binding RotateLeftCommand}" Margin="0,0,4,0" />
                        <Button Style="{StaticResource BtnSecondary}" Content="⟳ +90°" Command="{Binding RotateRightCommand}" Margin="0,0,4,0" />
                        <Button Style="{StaticResource BtnSecondary}" Content="🔍 Reset Zoom" Command="{Binding ResetZoomCommand}" Margin="0,0,4,0" />
                        <Button Style="{StaticResource BtnSecondary}" Content="◀ Prev" Command="{Binding PrevImageCommand}" Margin="0,0,4,0" />
                        <Button Style="{StaticResource BtnSecondary}" Content="Next ▶" Command="{Binding NextImageCommand}" />
                    </StackPanel>
                </Border>

                <!-- Image Metadata Floating Badge (Bottom Left) -->
                <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="16" Background="#cc0f172a" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Bill Date: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Text="{Binding SelectedImage.DateFormatted}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccentSky}" Margin="0,0,10,0" />
                        <TextBlock Text="File: " FontSize="11" Foreground="{StaticResource BrushTextSecondary}" />
                        <TextBlock Text="{Binding SelectedImage.Filename}" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. Bottom Filmstrip / Photo History Timeline -->
            <Border Grid.Row="2" Background="{StaticResource BrushBgDarkest}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="0,1,0,0" Padding="12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="Cycle History" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="0,0,12,0" />

                    <!-- Thumbnails List -->
                    <ListBox Grid.Column="1" 
                             ItemsSource="{Binding Images}" 
                             SelectedItem="{Binding SelectedImage, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,8,0" Cursor="Hand" Width="130">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DateFormatted}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccentSky}" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                        <TextBlock Text="{Binding Filename}" FontSize="9" Foreground="{StaticResource BrushTextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="115" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
