<Window x:Class="SpotImageViewer.Native.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Spot Image Viewer &amp; Verification Studio (v0.0.1 Native WPF)" 
        Height="850" Width="1340"
        MinWidth="960" MinHeight="600"
        WindowState="Maximized"
        Background="{StaticResource BrushBgMain}"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource BrushBgMain}">
        <Grid.RowDefinitions>
            <!-- Row 0: Top Header -->
            <RowDefinition Height="56" />
            <!-- Row 1: Main Content Tabs -->
            <RowDefinition Height="*" />
            <!-- Row 2: Status Bar -->
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- ==================== ROW 0: TOP HEADER ==================== -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <!-- App Logo & Title -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Navigation Tabs -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Global Search Bar -->
                    <ColumnDefinition Width="*" />
                    <!-- Right Actions & Stats -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 1. Logo & App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource BrushAccentSkyDark}" Margin="0,0,10,0">
                        <TextBlock Text="📷" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SPOT IMAGE VIEWER" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="Verification Studio v0.0.1 (WPF)" FontSize="10" Foreground="{StaticResource BrushAccentSky}" />
                    </StackPanel>
                </StackPanel>

                <!-- 2. Nav Tabs -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <RadioButton x:Name="rbTabViewer" Content="📸 Viewer" Style="{StaticResource NavTabButton}" IsChecked="True" Checked="NavTab_Checked" Margin="0,0,4,0" />
                    <RadioButton x:Name="rbTabTariff" Content="⚡ Tariff &amp; Theft" Style="{StaticResource NavTabButton}" Checked="NavTab_Checked" Margin="0,0,4,0" />
                    <RadioButton x:Name="rbTabFuzzy" Content="🔍 Fuzzy Search" Style="{StaticResource NavTabButton}" Checked="NavTab_Checked" Margin="0,0,4,0" />
                    <RadioButton x:Name="rbTabAudit" Content="📋 Audit Studio" Style="{StaticResource NavTabButton}" Checked="NavTab_Checked" Margin="0,0,4,0" />
                    <RadioButton x:Name="rbTabLiveOsd" Content="🌐 Live OSD" Style="{StaticResource NavTabButton}" Checked="NavTab_Checked" Margin="0,0,4,0" />
                    <RadioButton x:Name="rbTabSettings" Content="⚙️ Settings" Style="{StaticResource NavTabButton}" Checked="NavTab_Checked" />
                </StackPanel>

                <!-- 3. Global Search Bar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                    <TextBox x:Name="txtGlobalSearch" Width="260" Style="{StaticResource ModernTextBox}" Tag="Consumer ID, Meter No, or Name..." KeyDown="TxtGlobalSearch_KeyDown" />
                    <Button x:Name="btnSearch" Content="Search" Style="{StaticResource AccentButton}" Margin="6,0,0,0" Padding="12,6" Click="BtnSearch_Click" />
                    <Button x:Name="btnClearSearch" Content="✕" Style="{StaticResource ModernButton}" Margin="4,0,0,0" Padding="8,6" Click="BtnClearSearch_Click" ToolTip="Reset / Clear Search" />
                </StackPanel>

                <!-- 4. Top-Right Image Count Badge & Online Dot -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="badgeFolderStatus" Background="{StaticResource BrushBgInput}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="10,4" Cursor="Hand" MouseDown="BadgeFolderStatus_MouseDown" ToolTip="Click to view folder details">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="dotStatus" Width="8" Height="8" Fill="{StaticResource BrushAccentEmerald}" Margin="0,0,6,0" />
                            <TextBlock x:Name="txtImageCountHeader" Text="Scanning..." FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== ROW 1: CONTENT AREA ==================== -->
        <Grid Grid.Row="1">

            <!-- TAB 1: SPOT IMAGE VIEWER -->
            <Grid x:Name="panelViewer" Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <!-- Consumer Master Sidebar -->
                    <ColumnDefinition Width="340" MinWidth="260" MaxWidth="440" />
                    <!-- Splitter -->
                    <ColumnDefinition Width="1" />
                    <!-- Main Photo Pane & Welcome View -->
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Sidebar: Consumer Master Details -->
                <Border Grid.Column="0" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,1,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16" x:Name="panelConsumerSidebar">
                            
                            <!-- Sidebar Header -->
                            <Grid Margin="0,0,0,12">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="CONSUMER MASTER" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushAccentSky}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border x:Name="badgeStatus" HorizontalAlignment="Right" Background="#064e3b" CornerRadius="4" Padding="6,2">
                                    <TextBlock x:Name="txtStatusBadge" Text="ACTIVE" FontSize="10" FontWeight="Bold" Foreground="#34d399" />
                                </Border>
                            </Grid>

                            <!-- Consumer ID Card -->
                            <Border Background="{StaticResource BrushBgInput}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="CONSUMER ID" FontSize="10" Foreground="{StaticResource BrushTextMuted}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="txtCID" Text="-" FontSize="18" FontWeight="Bold" Foreground="{StaticResource BrushAccentSky}" Margin="0,2,0,0" />
                                    <TextBlock x:Name="txtConsumerName" Text="No consumer selected" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    <TextBlock x:Name="txtAddress" Text="Search by 9-digit CID above to inspect spot bill records." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Key Master Specs Grid -->
                            <Border Background="{StaticResource BrushBgInput}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Row 0: Category & Phase -->
                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="TARIFF / CATEGORY" FontSize="9" Foreground="{StaticResource BrushTextMuted}" FontWeight="Bold" />
                                        <TextBlock x:Name="txtTariff" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="PHASE" FontSize="9" Foreground="{StaticResource BrushTextMuted}" FontWeight="Bold" />
                                        <TextBlock x:Name="txtPhase" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                                    </StackPanel>

                                    <!-- Row 1: Connected Load & Meter No -->
                                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,0,8">
                                        <TextBlock Text="CONNECTED LOAD" FontSize="9" Foreground="{StaticResource BrushTextMuted}" FontWeight="Bold" />
                                        <TextBlock x:Name="txtLoad" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,8">
                                        <TextBlock Text="METER NO" FontSize="9" Foreground="{StaticResource BrushTextMuted}" FontWeight="Bold" />
                                        <TextBlock x:Name="txtMeterNo" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                                    </StackPanel>

                                    <!-- Row 2: Office & Contact -->
                                    <StackPanel Grid.Row="2" Grid.Column="0">
                                        <TextBlock Text="OFFICE / CCC" FontSize="9" Foreground="{StaticResource BrushTextMuted}" FontWeight="Bold" />
                                        <TextBlock x:Name="txtOffice" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Row="2" Grid.Column="1">
                                        <TextBlock Text="MOBILE" FontSize="9" Foreground="{StaticResource BrushTextMuted}" FontWeight="Bold" />
                                        <TextBlock x:Name="txtMobile" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Live OSD Summary Badge -->
                            <Border x:Name="cardOsdSummary" Background="#1e1b4b" BorderBrush="#3730a3" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="LIVE SAP OUTSTANDING" FontSize="10" FontWeight="Bold" Foreground="#a5b4fc" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <TextBlock x:Name="txtOsdTotalDues" Text="₹0.00" FontSize="16" FontWeight="Bold" Foreground="#818cf8" />
                                        <TextBlock x:Name="txtOsdDocType" Text="NO DUES" FontSize="10" FontWeight="Bold" Margin="8,4,0,0" Foreground="#34d399" />
                                    </StackPanel>
                                    <TextBlock x:Name="txtOsdDetails" Text="OSD: ₹0 | LPSC: ₹0" FontSize="10" Foreground="#c7d2fe" Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>

                            <!-- Available Cycles Section -->
                            <TextBlock Text="AVAILABLE SPOT BILL PHOTOS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,4,0,6" />
                            <StackPanel x:Name="panelPhotoChips" Margin="0,0,0,12">
                                <TextBlock Text="No consumer loaded" FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                            </StackPanel>

                            <!-- Quick Action Buttons -->
                            <StackPanel Orientation="Vertical">
                                <Button x:Name="btnFetchLiveOsdQuick" Content="🌐 Check Live OSD Portal" Style="{StaticResource ModernButton}" Margin="0,0,0,6" Click="BtnFetchLiveOsdQuick_Click" />
                                <Button x:Name="btnCalcTariffQuick" Content="⚡ Open in Tariff Calculator" Style="{StaticResource ModernButton}" Click="BtnCalcTariffQuick_Click" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Splitter -->
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="{StaticResource BrushBorderSubtle}" />

                <!-- Main Viewport (Column 2) -->
                <Grid Grid.Column="2">

                    <!-- ================= WELCOME SCREEN ================= -->
                    <!-- Designed to auto-fit viewport without vertical scrolling -->
                    <Grid x:Name="panelWelcome" Visibility="Visible" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="820">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            
                            <!-- Hero Icon & Glow -->
                            <Grid HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1">
                                    <TextBlock Text="📷" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>

                            <!-- Hero Title & Subtitle -->
                            <TextBlock Text="Welcome to Spot Image Viewer" FontSize="22" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                            <TextBlock Text="Ultra-fast spot bill photo verification, consumer master intelligence, and live SAP portal audit studio." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,20" MaxWidth="600" TextWrapping="Wrap" />

                            <!-- 4-Feature Cards Responsive Grid -->
                            <UniformGrid Columns="4" Margin="0,0,0,20">
                                <!-- Card 1 -->
                                <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="🔍" FontSize="18" Margin="0,0,0,4" />
                                        <TextBlock Text="Instant Search" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2" />
                                        <TextBlock Text="Lookup by 9-digit CID, Meter No, or Name with auto-detection." FontSize="10" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Card 2 -->
                                <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="📸" FontSize="18" Margin="0,0,0,4" />
                                        <TextBlock Text="Cycle Timeline" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2" />
                                        <TextBlock Text="Inspect multi-month spot bill photos side-by-side in native DirectX." FontSize="10" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Card 3 -->
                                <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="⚡" FontSize="18" Margin="0,0,0,4" />
                                        <TextBlock Text="Live OSD Portal" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2" />
                                        <TextBlock Text="Real-time SAP WebDynpro outstanding dues, LPSC, and connection status." FontSize="10" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!-- Card 4 -->
                                <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="4">
                                    <StackPanel>
                                        <TextBlock Text="📋" FontSize="18" Margin="0,0,0,4" />
                                        <TextBlock Text="Audit Studio" FontWeight="Bold" FontSize="11" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,2" />
                                        <TextBlock Text="High-speed low consumption filtering, defect detection, and Excel export." FontSize="10" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Keyboard Shortcuts Bar -->
                            <Border Background="{StaticResource BrushBgInput}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12,6" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="SHORTCUTS:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <TextBlock Text="[ / ] Focus Search   •   [ Enter ] Lookup   •   [ ← / → ] Switch Photos   •   [ Esc ] Clear" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </Grid>

                    <!-- ================= ACTIVE PHOTO VIEWER ================= -->
                    <Grid x:Name="panelPhotoViewer" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <!-- Toolbar -->
                            <RowDefinition Height="42" />
                            <!-- Image Canvas -->
                            <RowDefinition Height="*" />
                            <!-- Bottom Filmstrip -->
                            <RowDefinition Height="90" />
                        </Grid.RowDefinitions>

                        <!-- Top Photo Controls Toolbar -->
                        <Border Grid.Row="0" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,0,0,1">
                            <Grid Margin="12,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Current Photo Info -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtPhotoMetaHeader" Text="Photo 1 of 1 • 30-04-2026" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,12,0" />
                                    <TextBlock x:Name="txtPhotoFileStatus" Text="(Online)" FontSize="10" Foreground="{StaticResource BrushAccentEmerald}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Zoom & Transform Tools -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="btnZoomIn" Content="🔍+ Zoom In" Style="{StaticResource ModernButton}" Padding="8,4" Margin="0,0,4,0" Click="BtnZoomIn_Click" />
                                    <Button x:Name="btnZoomOut" Content="🔍- Zoom Out" Style="{StaticResource ModernButton}" Padding="8,4" Margin="0,0,4,0" Click="BtnZoomOut_Click" />
                                    <Button x:Name="btnZoomFit" Content="⛶ Fit" Style="{StaticResource ModernButton}" Padding="8,4" Margin="0,0,4,0" Click="BtnZoomFit_Click" />
                                    <Button x:Name="btnRotate" Content="↻ Rotate" Style="{StaticResource ModernButton}" Padding="8,4" Margin="0,0,4,0" Click="BtnRotate_Click" />
                                    <Button x:Name="btnInvert" Content="🌓 Invert" Style="{StaticResource ModernButton}" Padding="8,4" Margin="0,0,4,0" Click="BtnInvert_Click" />
                                    <Button x:Name="btnOpenExternal" Content="↗ Open" Style="{StaticResource ModernButton}" Padding="8,4" Click="BtnOpenExternal_Click" ToolTip="Open in Default Windows Viewer" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Center Hardware-Accelerated Pan/Zoom Canvas -->
                        <Border Grid.Row="1" Background="#020617" ClipToBounds="True" x:Name="borderImageContainer" MouseWheel="BorderImageContainer_MouseWheel" MouseDown="BorderImageContainer_MouseDown" MouseMove="BorderImageContainer_MouseMove" MouseUp="BorderImageContainer_MouseUp" Cursor="SizeAll">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Image x:Name="imgMain" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Image.LayoutTransform>
                                        <RotateTransform x:Name="imgRotateTransform" Angle="0" />
                                    </Image.LayoutTransform>
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="imgScaleTransform" ScaleX="1" ScaleY="1" />
                                            <TranslateTransform x:Name="imgTranslateTransform" X="0" Y="0" />
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>
                            </Grid>
                        </Border>

                        <!-- Bottom Thumbnail Filmstrip Carousel -->
                        <Border Grid.Row="2" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="panelFilmstrip" Orientation="Horizontal" Margin="8,6" VerticalAlignment="Center" />
                            </ScrollViewer>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>

            <!-- TAB 2: TARIFF & THEFT CALCULATOR -->
            <Grid x:Name="panelTariff" Visibility="Collapsed" Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left: Calculator Inputs Form -->
                <Border Grid.Column="0" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,16,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="TARIFF &amp; THEFT ASSESSMENT ENGINE" FontWeight="Bold" FontSize="12" Foreground="{StaticResource BrushAccentSky}" Margin="0,0,0,12" />
                            
                            <!-- Category -->
                            <TextBlock Text="CONSUMER CATEGORY" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4" />
                            <ComboBox x:Name="cbTariffCategory" Height="32" Margin="0,0,0,10" Background="{StaticResource BrushBgInput}" Foreground="{StaticResource BrushTextPrimary}" />

                            <!-- Cycle & Days -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="BILLING CYCLE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4" />
                                    <ComboBox x:Name="cbBillingCycle" Height="32">
                                        <ComboBoxItem Content="Quarterly" IsSelected="True" />
                                        <ComboBoxItem Content="Monthly" />
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="DAYS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4" />
                                    <TextBox x:Name="txtCalcDays" Text="90" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>
                            </Grid>

                            <!-- Units & Connected Load -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="UNITS BILLED" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4" />
                                    <TextBox x:Name="txtCalcUnits" Text="150" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="CONNECTED LOAD (kVA/kW)" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,4" />
                                    <TextBox x:Name="txtCalcLoad" Text="1.0" Style="{StaticResource ModernTextBox}" />
                                </StackPanel>
                            </Grid>

                            <!-- Theft Specifics -->
                            <Border Background="{StaticResource BrushBgInput}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,6,0,12">
                                <StackPanel>
                                    <TextBlock Text="SECTION 126 / 135 THEFT ASSESSMENT" FontSize="10" FontWeight="Bold" Foreground="{StaticResource BrushAccentAmber}" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                            <TextBlock Text="PROV. DAYS (Max 365)" FontSize="9" Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBox x:Name="txtTheftProvDays" Text="365" Style="{StaticResource ModernTextBox}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                            <TextBlock Text="PROV. HOURS/DAY" FontSize="9" Foreground="{StaticResource BrushTextMuted}" />
                                            <TextBox x:Name="txtTheftProvHours" Text="24" Style="{StaticResource ModernTextBox}" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Button x:Name="btnExecuteCalc" Content="⚡ Compute Assessment" Style="{StaticResource AccentButton}" Padding="0,10" Click="BtnExecuteCalc_Click" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Right: Calculation Breakdown -->
                <Border Grid.Column="1" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <StackPanel>
                        <TextBlock Text="CALCULATION RESULTS &amp; CHARGE SLABS" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,12" />
                        
                        <!-- Summary Highlight Cards -->
                        <UniformGrid Columns="3" Margin="0,0,0,16">
                            <Border Background="{StaticResource BrushBgInput}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="ASSESSED ENERGY" FontSize="10" Foreground="{StaticResource BrushTextMuted}" FontWeight="Bold" />
                                    <TextBlock x:Name="txtResAssessedUnits" Text="0 Units" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushAccentSky}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BrushBgInput}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="3,0,3,0">
                                <StackPanel>
                                    <TextBlock Text="ENERGY CHARGES" FontSize="10" Foreground="{StaticResource BrushTextMuted}" FontWeight="Bold" />
                                    <TextBlock x:Name="txtResEnergyCharge" Text="₹0.00" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushAccentEmerald}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Background="{StaticResource BrushBgInput}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="TOTAL PAYABLE" FontSize="10" Foreground="{StaticResource BrushTextMuted}" FontWeight="Bold" />
                                    <TextBlock x:Name="txtResTotalPayable" Text="₹0.00" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushAccentAmber}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <TextBlock Text="DETAILED CHARGES BREAKDOWN" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,6" />
                        <Border Background="{StaticResource BrushBgInput}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <TextBlock x:Name="txtResBreakdown" Text="Select category and parameters on the left, then click Compute Assessment." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- TAB 3: FUZZY SEARCH -->
            <Grid x:Name="panelFuzzy" Visibility="Collapsed" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBox x:Name="txtFuzzyInput" Width="400" Style="{StaticResource ModernTextBox}" Tag="Search by consumer name, address, or meter number..." KeyDown="TxtFuzzyInput_KeyDown" />
                    <Button x:Name="btnRunFuzzySearch" Content="🔍 Search Master Database" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="BtnRunFuzzySearch_Click" />
                </StackPanel>

                <!-- Virtualized Results DataGrid -->
                <DataGrid x:Name="gridFuzzyResults" Grid.Row="1" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" MouseDoubleClick="GridFuzzyResults_MouseDoubleClick" RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CONSUMER ID" Binding="{Binding ConsumerId}" Width="140" />
                        <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="260" />
                        <DataGridTextColumn Header="ADDRESS" Binding="{Binding Address}" Width="*" />
                        <DataGridTextColumn Header="METER NO" Binding="{Binding MeterNo}" Width="140" />
                        <DataGridTextColumn Header="OFFICE" Binding="{Binding Office}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- TAB 4: AUDIT STUDIO -->
            <Grid x:Name="panelAudit" Visibility="Collapsed" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBlock Text="FILTER LOW CONSUMPTION:" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="txtAuditMaxUnits" Width="80" Text="30" Style="{StaticResource ModernTextBox}" Margin="0,0,8,0" />
                    <Button x:Name="btnRunAudit" Content="📋 Load Low Consumption Audit List" Style="{StaticResource AccentButton}" Margin="0,0,12,0" Click="BtnRunAudit_Click" />
                    <Button x:Name="btnExportAuditCsv" Content="📥 Export CSV" Style="{StaticResource ModernButton}" Click="BtnExportAuditCsv_Click" />
                </StackPanel>

                <DataGrid x:Name="gridAuditResults" Grid.Row="1" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single" MouseDoubleClick="GridAuditResults_MouseDoubleClick" RowHeight="32">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="CONSUMER ID" Binding="{Binding ConsumerId}" Width="140" />
                        <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="240" />
                        <DataGridTextColumn Header="CONSUMPTION (UNITS)" Binding="{Binding Units}" Width="160" />
                        <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="160" />
                        <DataGridTextColumn Header="METER NO" Binding="{Binding MeterNo}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- TAB 5: LIVE OSD PORTAL -->
            <Grid x:Name="panelLiveOsd" Visibility="Collapsed" Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <TextBox x:Name="txtLiveOsdCidInput" Width="240" Style="{StaticResource ModernTextBox}" Tag="Enter 9-digit CID..." />
                    <Button x:Name="btnFetchLiveOsd" Content="🌐 Query WBSEDCL SAP Portal" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="BtnFetchLiveOsd_Click" />
                </StackPanel>

                <Border Grid.Row="1" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="panelOsdResultContent">
                            <TextBlock Text="Enter Consumer ID above and click Query to retrieve real-time SAP WebDynpro outstanding dues." FontSize="12" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <!-- TAB 6: SETTINGS -->
            <Grid x:Name="panelSettings" Visibility="Collapsed" Margin="24">
                <Border Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="8" Padding="20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="STORAGE &amp; IMAGE DIRECTORY CONFIGURATION" FontWeight="Bold" FontSize="13" Foreground="{StaticResource BrushAccentSky}" Margin="0,0,0,16" />
                            
                            <!-- Folders List -->
                            <TextBlock Text="REGISTERED IMAGE DIRECTORIES" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" />
                            <StackPanel x:Name="panelSettingsFoldersList" Margin="0,0,0,16">
                                <TextBlock Text="Loading folder paths..." FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                            </StackPanel>

                            <!-- Folder Actions -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                                <Button x:Name="btnAddFolder" Content="➕ Add Additional Image Folder" Style="{StaticResource AccentButton}" Margin="0,0,8,0" Click="BtnAddFolder_Click" />
                                <Button x:Name="btnRefreshFolders" Content="🔄 Refresh Status &amp; Recheck Folders" Style="{StaticResource ModernButton}" Click="BtnRefreshFolders_Click" />
                            </StackPanel>

                            <!-- App Info / System Stats -->
                            <TextBlock Text="SYSTEM STATS" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextMuted}" Margin="0,0,0,8" />
                            <Border Background="{StaticResource BrushBgInput}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel>
                                    <TextBlock x:Name="txtSettingsSystemInfo" Text="SpotImageViewer Native v0.0.1 (Pure WPF Architecture)" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" />
                                    <TextBlock Text="Runs 100% natively via DirectX without Chromium or browser engine." FontSize="11" Foreground="{StaticResource BrushTextSecondary}" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

        </Grid>

        <!-- ==================== ROW 2: STATUS BAR ==================== -->
        <Border Grid.Row="2" Background="{StaticResource BrushBgInput}" BorderBrush="{StaticResource BrushBorderSubtle}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="txtStatusMessage" Grid.Column="0" Text="Ready" FontSize="11" Foreground="{StaticResource BrushTextSecondary}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="SpotImageViewer v0.0.1 (Native WPF) • SQLite images_v7.db" FontSize="11" Foreground="{StaticResource BrushTextMuted}" VerticalAlignment="Center" />
            </Grid>
        </Border>

    </Grid>
</Window>
