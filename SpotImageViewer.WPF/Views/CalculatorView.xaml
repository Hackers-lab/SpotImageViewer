<UserControl x:Class="SpotImageViewer.WPF.Views.CalculatorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000">

    <Grid Background="{StaticResource BrushBgDark}" Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 1. Left Panel: Bill Calculator -->
        <Border Grid.Column="0" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="12" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="⚡ Tariff Bill Calculator" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16" />

                    <!-- Category -->
                    <TextBlock Text="Tariff Category" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" Margin="0,0,0,12" Padding="8,6" Background="#0f172a" Foreground="#f8fafc" />

                    <!-- Cycle & Days -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Billing Cycle" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Cycles}" SelectedItem="{Binding Cycle}" Padding="8,6" Background="#0f172a" Foreground="#f8fafc" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Days" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Days, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchTextBox}" />
                        </StackPanel>
                    </Grid>

                    <!-- Units & Load -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Total Units (kWh)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Units, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Connected Load (kVA)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding Load, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchTextBox}" />
                        </StackPanel>
                    </Grid>

                    <Button Style="{StaticResource BtnPrimary}" Content="Calculate Bill" Command="{Binding CalculateBillCommand}" Margin="0,0,0,16" />

                    <!-- Result Box -->
                    <Border Background="{StaticResource BrushBgDarkest}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <TextBlock Text="{Binding BillSummary}" FontFamily="Consolas, monospace" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- 2. Right Panel: Dual Theft Assessment -->
        <Border Grid.Column="2" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="12" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="⚖️ Dual Theft Assessment (U/S 135)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" Margin="0,0,0,16" />

                    <!-- Category -->
                    <TextBlock Text="Audit Category" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                    <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding TheftCategory}" Margin="0,0,0,12" Padding="8,6" Background="#0f172a" Foreground="#f8fafc" />

                    <!-- Load -->
                    <TextBlock Text="Detected Connected Load (kVA)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding TheftLoad, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchTextBox}" Margin="0,0,0,12" />

                    <!-- Provisional & Final Days -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Prov. Days (Default 365)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding DaysProv, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Final Days" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding DaysFinal, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchTextBox}" />
                        </StackPanel>
                    </Grid>

                    <!-- Hours / Day -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Prov. Hours/Day" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding ProvHours, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchTextBox}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Final Hours/Day" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource BrushTextSecondary}" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FinalHours, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchTextBox}" />
                        </StackPanel>
                    </Grid>

                    <Button Style="{StaticResource BtnPrimary}" Content="Assess Dual Theft" Command="{Binding CalculateTheftCommand}" Margin="0,0,0,16" />

                    <!-- Result Box -->
                    <Border Background="{StaticResource BrushBgDarkest}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" CornerRadius="8" Padding="14">
                        <TextBlock Text="{Binding TheftSummary}" FontFamily="Consolas, monospace" FontSize="12" Foreground="{StaticResource BrushTextPrimary}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
