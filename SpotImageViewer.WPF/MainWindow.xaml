<Window x:Class="SpotImageViewer.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SpotImageViewer.WPF.Views"
        Title="Spot Image Viewer (v0.0.1 Native WPF)" 
        Height="850" Width="1340"
        MinWidth="1000" MinHeight="680"
        WindowState="Maximized"
        Background="{StaticResource BrushBgDarkest}"
        WindowStartupLocation="CenterScreen">

    <Grid Background="{StaticResource BrushBgDarkest}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- Top Header Bar -->
            <RowDefinition Height="*" />    <!-- Main Tabs Content -->
        </Grid.RowDefinitions>

        <!-- ============================================================ -->
        <!-- TOP HEADER BAR                                               -->
        <!-- ============================================================ -->
        <Border Grid.Row="0" Background="{StaticResource BrushBgDark}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" /> <!-- Logo & Title -->
                    <ColumnDefinition Width="Auto" /> <!-- Nav Tabs -->
                    <ColumnDefinition Width="*" />    <!-- Search Bar -->
                    <ColumnDefinition Width="Auto" /> <!-- Top Right Live Stats -->
                </Grid.ColumnDefinitions>

                <!-- 1. Logo & App Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0" Cursor="Hand" MouseDown="OnLogoMouseDown">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource BrushAccentSky}" Margin="0,0,10,0">
                        <TextBlock Text="📷" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="SPOT IMAGE VIEWER" FontSize="14" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                        <TextBlock Text="Pure Native DirectX Engine (v0.0.1)" FontSize="10" Foreground="{StaticResource BrushTextSecondary}" />
                    </StackPanel>
                </StackPanel>

                <!-- 2. Nav Tabs Header (Viewer, Calculators) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <RadioButton x:Name="TabRadioViewer" 
                                 Content="📷 Viewer" 
                                 IsChecked="True" 
                                 Checked="OnTabRadioChecked" 
                                 Style="{StaticResource {x:Type ToggleButton}}" 
                                 Background="{StaticResource BrushBgCard}" 
                                 Foreground="{StaticResource BrushTextPrimary}" 
                                 BorderBrush="{StaticResource BrushBorderDark}" 
                                 Padding="14,8" 
                                 Margin="0,0,6,0" 
                                 Cursor="Hand" />
                    <RadioButton x:Name="TabRadioCalc" 
                                 Content="⚡ Calculators" 
                                 Checked="OnTabRadioChecked" 
                                 Style="{StaticResource {x:Type ToggleButton}}" 
                                 Background="{StaticResource BrushBgCard}" 
                                 Foreground="{StaticResource BrushTextPrimary}" 
                                 BorderBrush="{StaticResource BrushBorderDark}" 
                                 Padding="14,8" 
                                 Cursor="Hand" />
                </StackPanel>

                <!-- 3. Global Search Input -->
                <Grid Grid.Column="2" MaxWidth="480" HorizontalAlignment="Left" Width="400">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="GlobalSearchInput" 
                             Grid.Column="0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource SearchTextBox}" 
                             KeyDown="OnSearchInputKeyDown"
                             Margin="0,0,6,0" />

                    <Button Grid.Column="1" 
                            Style="{StaticResource BtnPrimary}" 
                            Content="🔍 Search" 
                            Command="{Binding SearchCommand}" 
                            Padding="14,8" />
                </Grid>

                <!-- 4. Top Right Stats & Folder Status -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Available Images Stat -->
                    <Border CornerRadius="8" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" Padding="10,6" Margin="0,0,8,0" Cursor="Hand" MouseDown="OnFoldersButtonClick">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Online / Offline Dot -->
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource BrushAccentEmerald}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasOfflineFolders}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource BrushAccentAmber}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding AvailableImages, StringFormat='{}{0:N0} Available'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextPrimary}" />
                            <TextBlock Text="{Binding TotalImages, StringFormat='{} / {0:N0} Total'}" FontSize="10" Foreground="{StaticResource BrushTextMuted}" Margin="4,0,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Consumers Stat -->
                    <Border CornerRadius="8" Background="{StaticResource BrushBgCard}" BorderBrush="{StaticResource BrushBorderDark}" BorderThickness="1" Padding="10,6" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👥 " FontSize="11" />
                            <TextBlock Text="{Binding ConsumerCount, StringFormat='{}{0:N0} Cons.'}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource BrushTextSecondary}" />
                        </StackPanel>
                    </Border>

                    <!-- Folder Settings Button -->
                    <Button Style="{StaticResource BtnSecondary}" Content="📁 Folders" Click="OnFoldersButtonClick" Padding="10,6" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============================================================ -->
        <!-- MAIN CONTENT TABS                                            -->
        <!-- ============================================================ -->
        <Grid Grid.Row="1">
            <!-- 1. Viewer Tab -->
            <views:ViewerView x:Name="ViewerTabContent" 
                              DataContext="{Binding ViewerVM}" 
                              Visibility="Visible" />

            <!-- 2. Calculator Tab -->
            <views:CalculatorView x:Name="CalculatorTabContent" 
                                  DataContext="{Binding CalculatorVM}" 
                                  Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
